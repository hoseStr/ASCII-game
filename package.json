{
  "name": "ascii-demo-game",
  "private": true,
  "version": "0.1.0",
  "description": "Aventura de acción top-down onírica renderizada como video ASCII en tiempo real (WebGL2).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "shots": "node tools/screenshot.mjs",
    "verify:stamps": "node tools/verify_stamps.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "playwright": "1.63.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
